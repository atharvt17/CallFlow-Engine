# ============================================================================
# collections-voice-agent — environment template (SPECS §8)
#
# Copy to `.env` and adjust as needed. `.env` is git-ignored; this file is not.
# Defaults below are exactly the shipped defaults from SPECS §8.
# No secrets exist in Round 1 — the stack is fully local. These are
# configuration knobs, not credentials.
# ============================================================================

# --- Inference service ------------------------------------------------------

# Bind address for the inference API.
SERVICE_HOST=0.0.0.0
# Bind port for the inference API.
SERVICE_PORT=8000
# Pipeline backend implementation: `http` (Appendix B service) or `inline` (no-op, tests).
PIPELINE_BACKEND=http
# Base URL of the pipeline dependency; integration point for an external/scoring mock.
PIPELINE_BASE_URL=http://localhost:8100
# Total attempts for one logical pipeline call (first attempt + retries).
MAX_ATTEMPTS=3
# Per-attempt timeout in seconds (p99 ≈ 1.2s + headroom).
PIPELINE_TIMEOUT_S=2.5
# Backoff delay before retry k = base · factor^(k−1), in milliseconds.
BACKOFF_BASE_MS=100
# Exponential growth factor between retries.
BACKOFF_FACTOR=2.0
# Upper cap for a single backoff delay, in milliseconds.
BACKOFF_MAX_MS=1000
# Uniform ±jitter fraction applied to each backoff delay (0.5 → ±50%).
BACKOFF_JITTER=0.5
# Circuit breaker sliding window size (completed logical calls).
CB_WINDOW_SIZE=20
# Trip when the logical-call failure ratio ≥ this value (min throughput met).
CB_FAILURE_THRESHOLD=0.5
# Minimum logical-call outcomes in the window before ratio tripping applies.
CB_MIN_THROUGHPUT=10
# Trip when this many consecutive logical calls fail.
CB_CONSECUTIVE_FAILURES=5
# Seconds the breaker stays OPEN before transitioning to HALF_OPEN.
CB_COOLDOWN_S=5.0
# Max concurrent probe logical calls admitted in HALF_OPEN.
CB_HALF_OPEN_PROBES=3
# Successful probes required to CLOSE the breaker.
CB_HALF_OPEN_SUCCESS=2
# In-memory deferred-FIFO capacity (backpressure only — SQLite is authoritative).
DEFER_QUEUE_MAX=5000
# Max seconds a deferred event may wait before expiry → DLQ (deferred_expired).
DEFER_MAX_AGE_S=3600
# Probability that a successful pipeline call is recorded as `ptp_taken`.
SUCCESS_PTP_RATE=0.0
# SQLite database file (runtime-only, git-ignored).
DB_PATH=data/collections.db
# Log verbosity; applies to both the inference and mock services.
LOG_LEVEL=INFO

# --- Mock service (Appendix B dependency) ------------------------------------

# Bind port for the pipeline mock.
MOCK_PORT=8100
# Fraction of requests answered with an immediate 503 (Appendix B default 0.20).
FAILURE_RATE=0.20
# Lognormal mu parameter for success-path latency (ms).
LATENCY_MU=5.7
# Lognormal sigma for success-path latency (calibrated per SPECS §4).
LATENCY_SIGMA=0.62
# Extra latency added to the failure path (0 = immediate 503, spec-literal).
FAILURE_LATENCY_MS=0

# --- Traffic generator (Appendix C replay) ------------------------------------

# Inference base URL the generator drives.
TARGET_URL=http://localhost:8000
# Simulated-time compression factor (60 → 24 sim-hours ≈ 24 real minutes).
SPEEDUP=60
# Length of the simulated day, in hours.
DURATION_SIM_HOURS=24
# Max in-flight request cap for the generator.
CONCURRENCY=200
